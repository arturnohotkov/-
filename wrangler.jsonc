{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vorobtsi-integrity-api",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-20",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vorobtsi-integrity",
      "migrations_dir": "cloudflare/migrations"
    }
  ]
}
